investigation "complete_basic_triage" {
    metadata {
        author = "Forensic Analyst"
        priority = "High"
        category = "Incident Response"
    }

    collect system_info

    collect processes {
        pid
        name
        parent
        command_line
        user
        hash.sha256
    }

    collect network_connections

    export evidence "complete_triage_evidence.json"
}
