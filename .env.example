# TraceForge Environment Configuration
# Copy this file to .env and update values as needed

# Database
POSTGRES_PASSWORD=traceforge_dev

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=traceforge
MINIO_ROOT_PASSWORD=traceforge_dev

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET=dev_secret_change_in_production_at_least_32_chars_long

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Frontend
VITE_API_URL=http://localhost:8080

# Compiler Worker
WORKER_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=300
BUILD_MEMORY_LIMIT_MB=512

# Logging
RUST_LOG=info